    self:Log("All systems operational.", "accent")

    return self
end

-- Kinematic Smooth Dragging
function UILibrary:SetupKinematicDrag(frame)
    local isDragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    local targetPosition = frame.Position

    frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            -- Allow dragging from top area
            local mousePos = input.Position
            local framePos = frame.AbsolutePosition
            if mousePos.Y - framePos.Y <= 65 then
                isDragging = true
                dragStart = input.Position
                startPos = frame.Position

                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        isDragging = false
                    end
                end)
            end
        end
    end)

    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and isDragging then
            local delta = input.Position - dragStart
            targetPosition = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    RunService.RenderStepped:Connect(function(dt)
        if frame.Parent then
            local current = frame.Position
            local lerpFactor = math.clamp(dt * 18, 0, 1)
            frame.Position = UDim2.new(
                current.X.Scale,
                current.X.Offset + (targetPosition.X.Offset - current.X.Offset) * lerpFactor,
                current.Y.Scale,
                current.Y.Offset + (targetPosition.Y.Offset - current.Y.Offset) * lerpFactor
            )
        end
    end)
end

