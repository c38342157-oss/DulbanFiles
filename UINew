-- Tween Utility
local function TweenObject(object, properties, duration, easingStyle, easingDirection)
    local tweenInfo = TweenInfo.new(
        duration or 0.25,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

-- Math Utilities
local function LerpColor(colorA, colorB, alpha)
    alpha = math.clamp(alpha, 0, 1)
    return Color3.new(
        colorA.R + (colorB.R - colorA.R) * alpha,
        colorA.G + (colorB.G - colorA.G) * alpha,
        colorA.B + (colorB.B - colorA.B) * alpha
    )
end

