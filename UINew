-- Tab Builder with Vector Icons
function UILibrary:CreateTab(name, iconNameOrAsset)
    local tab = {
        Name = name,
        Icon = iconNameOrAsset,
        Elements = {},
        Frame = nil,
        Button = nil,
    }

    local iconAsset = ICONS[name] or ICONS[iconNameOrAsset] or iconNameOrAsset or ICONS.Zap

    local tabButton = Instance.new("TextButton")
    tabButton.Name = name .. "TabButton"
    tabButton.Size = UDim2.new(1, 0, 0, 44)
    tabButton.BackgroundColor3 = THEME.Surface
    tabButton.BackgroundTransparency = 1
    tabButton.BorderSizePixel = 0
    tabButton.Text = ""
    tabButton.AutoButtonColor = false
    tabButton.ZIndex = 5
    tabButton.LayoutOrder = #UI.Tabs + 1
    tabButton.Parent = UI.TabBar

    CreateCorner(tabButton, 8)
    ApplyTiltEffect(tabButton, 3)

    local tabIcon = CreateVectorIcon(tabButton, iconAsset, UDim2.new(0, 20, 0, 20), UDim2.new(0, 14, 0.5, 0), Vector2.new(0, 0.5), THEME.TextSecondary)
    tabIcon.ZIndex = 6

    local tabLabel = Instance.new("TextLabel")
    tabLabel.Size = UDim2.new(1, -50, 1, 0)
    tabLabel.Position = UDim2.new(0, 44, 0, 0)
    tabLabel.BackgroundTransparency = 1
    tabLabel.Text = name
    tabLabel.TextColor3 = THEME.TextSecondary
    tabLabel.TextSize = 13
    tabLabel.Font = Enum.Font.GothamMedium
    tabLabel.TextXAlignment = Enum.TextXAlignment.Left
    tabLabel.ZIndex = 6
    tabLabel.Parent = tabButton

    local activeBar = Instance.new("Frame")
    activeBar.Name = "ActiveBar"
    activeBar.Size = UDim2.new(0, 3, 0.6, 0)
    activeBar.Position = UDim2.new(0, 2, 0.5, 0)
    activeBar.AnchorPoint = Vector2.new(0, 0.5)
    activeBar.BackgroundColor3 = THEME.Primary
    activeBar.BorderSizePixel = 0
    activeBar.BackgroundTransparency = 1
    activeBar.ZIndex = 7
    activeBar.Parent = tabButton
    CreateCorner(activeBar, 2)

    -- Tab Content Canvas
    local contentFrame = Instance.new("ScrollingFrame")
    contentFrame.Name = name .. "Content"
    contentFrame.Size = UDim2.new(1, 0, 1, 0)
    contentFrame.Position = UDim2.new(0, 0, 0, 0)
    contentFrame.BackgroundTransparency = 1
    contentFrame.BorderSizePixel = 0
    contentFrame.ScrollBarThickness = 4
    contentFrame.ScrollBarImageColor3 = THEME.Primary
    contentFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    contentFrame.Visible = false
    contentFrame.ZIndex = 4
    contentFrame.Parent = UI.ContentPanel

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder
    contentLayout.Padding = UDim.new(0, 10)
    contentLayout.Parent = contentFrame

    local contentPadding = Instance.new("UIPadding")
    contentPadding.PaddingTop = UDim.new(0, 4)
    contentPadding.PaddingBottom = UDim.new(0, 14)
    contentPadding.PaddingLeft = UDim.new(0, 4)
    contentPadding.PaddingRight = UDim.new(0, 10)
    contentPadding.Parent = contentFrame

    contentLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        contentFrame.CanvasSize = UDim2.new(0, 0, 0, contentLayout.AbsoluteContentSize.Y + 20)
    end)

    tab.Frame = contentFrame
    tab.Button = tabButton

    -- Filter Search Elements
    tab.FilterElements = function(query)
        for _, elem in ipairs(tab.Elements) do
            if query == "" then
                elem.Visible = true
            else
                local nameMatch = elem.Name:lower():find(query) ~= nil
                elem.Visible = nameMatch
            end
        end
    end

    -- Tab Interactions
    tabButton.MouseEnter:Connect(function()
        if UI.CurrentTab ~= tab then
            TweenObject(tabButton, {BackgroundTransparency = 0.5, BackgroundColor3 = THEME.SurfaceHighlight}, 0.2)
            TweenObject(tabLabel, {TextColor3 = THEME.Text}, 0.2)
            TweenObject(tabIcon, {ImageColor3 = THEME.Text}, 0.2)
        end
    end)

    tabButton.MouseLeave:Connect(function()
        if UI.CurrentTab ~= tab then
            TweenObject(tabButton, {BackgroundTransparency = 1}, 0.2)
            TweenObject(tabLabel, {TextColor3 = THEME.TextSecondary}, 0.2)
            TweenObject(tabIcon, {ImageColor3 = THEME.TextSecondary}, 0.2)
        end
    end)

    tabButton.MouseButton1Click:Connect(function()
        CreateRippleEffect(tabButton, tabButton.AbsolutePosition.X + 20, tabButton.AbsolutePosition.Y + 20, THEME.Primary)
        self:OpenTab(tab)
    end)

    table.insert(UI.Tabs, tab)

    if #UI.Tabs == 1 then
        task.delay(0.05, function() self:OpenTab(tab) end)
    end

    return tab
end

-- Smooth Animated Tab Transition
function UILibrary:OpenTab(tab)
    if UI.CurrentTab == tab then return end

    if UI.CurrentTab then
        local prevTab = UI.CurrentTab
        local prevFrame = prevTab.Frame

        -- Animate Out Previous Tab
        TweenObject(prevTab.Button, {BackgroundTransparency = 1, BackgroundColor3 = THEME.Surface}, 0.25)
        local prevLabel = prevTab.Button:FindFirstChildWhichIsA("TextLabel")
        if prevLabel then TweenObject(prevLabel, {TextColor3 = THEME.TextSecondary}, 0.25) end
        local prevIcon = prevTab.Button:FindFirstChild("VectorIcon")
        if prevIcon then TweenObject(prevIcon, {ImageColor3 = THEME.TextSecondary}, 0.25) end
        local prevBar = prevTab.Button:FindFirstChild("ActiveBar")
        if prevBar then TweenObject(prevBar, {BackgroundTransparency = 1}, 0.2) end

        TweenObject(prevFrame, {Position = UDim2.new(0, -20, 0, 0)}, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.2, function()
            prevFrame.Visible = false
        end)
    end

    UI.CurrentTab = tab
    local nextFrame = tab.Frame
    nextFrame.Position = UDim2.new(0, 20, 0, 0)
    nextFrame.Visible = true

    -- Animate In New Tab
    TweenObject(tab.Button, {BackgroundTransparency = 0.2, BackgroundColor3 = THEME.Secondary}, 0.25)
    local nextLabel = tab.Button:FindFirstChildWhichIsA("TextLabel")
    if nextLabel then TweenObject(nextLabel, {TextColor3 = THEME.Text}, 0.25) end
    local nextIcon = tab.Button:FindFirstChild("VectorIcon")
    if nextIcon then TweenObject(nextIcon, {ImageColor3 = THEME.Primary}, 0.25) end
    local nextBar = tab.Button:FindFirstChild("ActiveBar")
    if nextBar then TweenObject(nextBar, {BackgroundTransparency = 0}, 0.25) end

    TweenObject(nextFrame, {Position = UDim2.new(0, 0, 0, 0)}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

