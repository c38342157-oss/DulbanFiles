-- 3D Tilt Effect (weight-sensing cursor tilt)
local function ApplyTiltEffect(guiObject, maxAngle, springFactor)
    maxAngle = maxAngle or 3.5
    springFactor = springFactor or 0.15

    local isHovered = false
    local currentRotation = 0
    local targetRotation = 0
    local originalPos = guiObject.Position

    local enterConn = guiObject.MouseEnter:Connect(function()
        isHovered = true
    end)

    local leaveConn = guiObject.MouseLeave:Connect(function()
        isHovered = false
        targetRotation = 0
        TweenObject(guiObject, {Rotation = 0}, 0.25, Enum.EasingStyle.Quad)
    end)

    local moveConn = UserInputService.InputChanged:Connect(function(input)
        if isHovered and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UserInputService:GetMouseLocation() - Vector2.new(0, 36) -- Roblox inset offset
            local objPos = guiObject.AbsolutePosition
            local objSize = guiObject.AbsoluteSize

            if objSize.X > 0 and objSize.Y > 0 then
                local relX = (mousePos.X - objPos.X) / objSize.X - 0.5
                local relY = (mousePos.Y - objPos.Y) / objSize.Y - 0.5

                targetRotation = math.clamp(relX * maxAngle, -maxAngle, maxAngle)
                TweenObject(guiObject, {Rotation = targetRotation}, 0.15, Enum.EasingStyle.Quad)
            end
        end
    end)

    table.insert(UI.TiltConnections, enterConn)
    table.insert(UI.TiltConnections, leaveConn)
    table.insert(UI.TiltConnections, moveConn)
end

-- Ripple Effect (expanding wave from click point)
local function CreateRippleEffect(guiObject, clickX, clickY, rippleColor)
    local ripple = Instance.new("Frame")
    ripple.Name = "Ripple"
    ripple.BackgroundColor3 = rippleColor or THEME.Primary
    ripple.BackgroundTransparency = 0.5
    ripple.BorderSizePixel = 0
    ripple.ZIndex = guiObject.ZIndex + 5
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = ripple

    local absPos = guiObject.AbsolutePosition
    local relX = clickX - absPos.X
    local relY = clickY - absPos.Y

    ripple.Position = UDim2.new(0, relX, 0, relY)
    ripple.Size = UDim2.new(0, 0, 0, 0)
    ripple.ClipsDescendants = true
    ripple.Parent = guiObject

    local maxSize = math.max(guiObject.AbsoluteSize.X, guiObject.AbsoluteSize.Y) * 2.2

    local tweenInfo = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local sizeTween = TweenService:Create(ripple, tweenInfo, {
        Size = UDim2.new(0, maxSize, 0, maxSize),
        BackgroundTransparency = 1
    })

    sizeTween:Play()
    sizeTween.Completed:Connect(function()
        ripple:Destroy()
    end)
end

-- Settings Management
local function SaveSettings()
    local settings = {
        MenuKeybind = tostring(UI.MenuKeybind),
        Keybinds = {},
        MobileButtonSize = UI.MobileButtonSize,
        Theme = UI.CurrentTheme
    }

    for toggleName, keyCode in pairs(UI.SavedKeybinds) do
        settings.Keybinds[toggleName] = tostring(keyCode)
    end

    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(settings))
    end)
end

local function LoadSettings()
    if isfile(SETTINGS_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_FILE))
        end)

        if success and result then
            if result.MenuKeybind then
                local keyCode = result.MenuKeybind:gsub("Enum.KeyCode.", "")
                UI.MenuKeybind = Enum.KeyCode[keyCode] or Enum.KeyCode.Home
            end
            if result.Keybinds then
                for toggleName, keyCodeStr in pairs(result.Keybinds) do
                    local keyCode = keyCodeStr:gsub("Enum.KeyCode.", "")
                    UI.SavedKeybinds[toggleName] = Enum.KeyCode[keyCode]
                end
            end
            if result.MobileButtonSize then
                UI.MobileButtonSize = result.MobileButtonSize
            end
            if result.Theme and Themes[result.Theme] then
                UI.CurrentTheme = result.Theme
                for k, v in pairs(Themes[result.Theme]) do
                    THEME[k] = v
                end
            end
            return true
        end
    end
    return false
end

-- Real-Time Dynamic Theme Engine
function UILibrary:SetTheme(themeName, customColor, shouldSave)
    local oldTheme = {}
    for k, v in pairs(THEME) do oldTheme[k] = v end

    if themeName == "Custom" then
        UI.CurrentTheme = "Custom"
        if customColor then
            THEME.Primary = customColor
            local h, s, v = customColor:ToHSV()
            THEME.Secondary = Color3.fromHSV(h, s, math.clamp(v - 0.2, 0, 1))
            THEME.Accent = Color3.fromHSV(h, math.clamp(s - 0.1, 0, 1), math.clamp(v + 0.1, 0, 1))
            THEME.Glow = customColor
        end
    elseif Themes[themeName] then
        UI.CurrentTheme = themeName
        for k, v in pairs(Themes[themeName]) do THEME[k] = v end
    else
        return
    end

    local function UpdateObjectColor(obj)
        if obj == UI.Backdrop then return end
        if obj.Name == "Spectrum" or obj.Name == "ValueSlider" then return end
        if string.sub(obj.Name, 1, 12) == "ThemeButton_" then return end

        if obj:IsA("GuiObject") then
            local bg = obj.BackgroundColor3
            if bg == oldTheme.Primary then obj.BackgroundColor3 = THEME.Primary
            elseif bg == oldTheme.Secondary then obj.BackgroundColor3 = THEME.Secondary
            elseif bg == oldTheme.Background then obj.BackgroundColor3 = THEME.Background
            elseif bg == oldTheme.Surface then obj.BackgroundColor3 = THEME.Surface
            elseif bg == oldTheme.SurfaceHighlight then obj.BackgroundColor3 = THEME.SurfaceHighlight
            elseif bg == oldTheme.Success then obj.BackgroundColor3 = THEME.Success
            elseif bg == oldTheme.Warning then obj.BackgroundColor3 = THEME.Warning
            elseif bg == oldTheme.Danger then obj.BackgroundColor3 = THEME.Danger
            end
        end

        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            local tc = obj.TextColor3
            if tc == oldTheme.Text then obj.TextColor3 = THEME.Text
            elseif tc == oldTheme.TextSecondary then obj.TextColor3 = THEME.TextSecondary
            elseif tc == oldTheme.Primary then obj.TextColor3 = THEME.Primary
            elseif tc == oldTheme.Success then obj.TextColor3 = THEME.Success
            elseif tc == oldTheme.Warning then obj.TextColor3 = THEME.Warning
            elseif tc == oldTheme.Danger then obj.TextColor3 = THEME.Danger
            end

            if obj:IsA("TextBox") and obj.PlaceholderColor3 == oldTheme.TextSecondary then
                obj.PlaceholderColor3 = THEME.TextSecondary
            end
        end

        if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            local imgCol = obj.ImageColor3
            if imgCol == oldTheme.Primary then obj.ImageColor3 = THEME.Primary
            elseif imgCol == oldTheme.Secondary then obj.ImageColor3 = THEME.Secondary
            elseif imgCol == oldTheme.Glow then obj.ImageColor3 = THEME.Glow
            elseif imgCol == oldTheme.Accent then obj.ImageColor3 = THEME.Accent
            end
        end

        if obj:IsA("UIStroke") then
            local strokeCol = obj.Color
            if strokeCol == oldTheme.Border then obj.Color = THEME.Border
            elseif strokeCol == oldTheme.Primary then obj.Color = THEME.Primary
            elseif strokeCol == oldTheme.Text then obj.Color = THEME.Text
            elseif strokeCol == oldTheme.TextSecondary then obj.Color = THEME.TextSecondary
            end
        end
    end

    if UI.ScreenGui then
        for _, v in ipairs(UI.ScreenGui:GetDescendants()) do
            UpdateObjectColor(v)
        end
    end

    if shouldSave ~= false then SaveSettings() end
end

