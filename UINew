-- Configs Tab
function UILibrary:CreateConfigTab()
    local configTab = self:CreateTab("Configs", "Configs")
    configTab.Button.LayoutOrder = 998

    self:CreateSectionHeader(configTab, "Save Profile", ICONS.Folder)

    local configInput = self:CreateTextbox(configTab, "Config Name", "e.g. MyPreset", "")

    self:CreateButton(configTab, "Save Configuration", function()
        local name = configInput.GetValue()
        if name and name ~= "" then
            local data = {Settings = {}}
            for regName, elem in pairs(UI.Registry) do
                if elem.GetValue then data.Settings[regName] = elem.GetValue() end
            end
            pcall(function()
                writefile(CONFIGS_FOLDER .. "/" .. name .. ".json", HttpService:JSONEncode(data))
            end)
            UILibrary.CreateNotification("Configs", "Saved: " .. name, 2)
        end
    end)

    return configTab
end

-- Dissolve & Evaporate Open/Close Window Animations
function UILibrary:ToggleUI()
    UI.IsOpen = not UI.IsOpen
    local scale = UI.MainFrame:FindFirstChild("WindowScale")

    if UI.IsOpen then
        UI.Backdrop.Visible = true
        UI.MainFrame.Visible = true

        if scale then scale.Scale = 0.82 end
        UI.MainFrame.BackgroundTransparency = 1

        TweenObject(UI.Backdrop, {BackgroundTransparency = 0.55}, 0.35)
        TweenObject(UI.MainFrame, {BackgroundTransparency = 0}, 0.35)
        if scale then
            TweenObject(scale, {Scale = 1}, 0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    else
        -- Dissolve / Shrink (evaporation effect)
        TweenObject(UI.Backdrop, {BackgroundTransparency = 1}, 0.3)
        TweenObject(UI.MainFrame, {BackgroundTransparency = 1}, 0.3)
        if scale then
            TweenObject(scale, {Scale = 0.85}, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        end

        task.delay(0.3, function()
            UI.MainFrame.Visible = false
            UI.Backdrop.Visible = false
        end)
    end
end

