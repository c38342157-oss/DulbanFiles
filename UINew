-- Console Logging
function UILibrary:Log(text, logType)
    local color = THEME.Text
    local prefix = "[i] "
    if logType == "success" or logType == "ok" then
        color = THEME.Success
        prefix = "[✓] "
    elseif logType == "warn" or logType == "warning" then
        color = THEME.Warning
        prefix = "[!] "
    elseif logType == "danger" or logType == "error" then
        color = THEME.Danger
        prefix = "[✕] "
    elseif logType == "accent" then
        color = THEME.Primary
        prefix = "[>] "
    end

    table.insert(UI.ConsoleLines, {Text = prefix .. tostring(text), Color = color})

    if UI.ConsoleContainer then
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 0, 18)
        label.BackgroundTransparency = 1
        label.Text = prefix .. tostring(text)
        label.TextColor3 = color
        label.TextSize = 12
        label.Font = Enum.Font.Code
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = UI.ConsoleContainer.ZIndex + 1
        label.Parent = UI.ConsoleContainer

        if UI.ConsoleContainer:IsA("ScrollingFrame") then
            UI.ConsoleContainer.CanvasPosition = Vector2.new(0, 9999)
        end
    end
end

