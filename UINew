    label.TextColor3 = THEME.Text
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 6
    label.Parent = toggleFrame

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.new(0, 46, 0, 24)
    switch.Position = UDim2.new(1, -56, 0.5, 0)
    switch.AnchorPoint = Vector2.new(0, 0.5)
    switch.BackgroundColor3 = toggleValue and THEME.Primary or THEME.Background
    switch.BorderSizePixel = 0
    switch.Text = ""
    switch.AutoButtonColor = false
    switch.ZIndex = 6
    switch.Parent = toggleFrame

    CreateCorner(switch, 12)
    CreateStroke(switch, THEME.Border, 1, 0.4)

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = toggleValue and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.BackgroundColor3 = THEME.Text
    knob.BorderSizePixel = 0
    knob.ZIndex = 7
    knob.Parent = switch

    CreateCorner(knob, 9)

    local function UpdateToggleState()
        if toggleValue then
            TweenObject(knob, {Position = UDim2.new(1, -21, 0.5, 0)}, 0.2)
            TweenObject(switch, {BackgroundColor3 = THEME.Primary}, 0.2)
        else
            TweenObject(knob, {Position = UDim2.new(0, 3, 0.5, 0)}, 0.2)
            TweenObject(switch, {BackgroundColor3 = THEME.Background}, 0.2)
        end

        UI.RegisteredToggles[toggleKey].value = toggleValue
        if callback then callback(toggleValue) end
    end

    switch.MouseButton1Click:Connect(function()
        toggleValue = not toggleValue
        CreateRippleEffect(switch, switch.AbsolutePosition.X + 23, switch.AbsolutePosition.Y + 12, THEME.Primary)
        UpdateToggleState()
    end)

    -- Keybind handling
    keybindBtn.MouseButton1Click:Connect(function()
        if isListeningForKey then return end
        isListeningForKey = true
        keybindBtn.Text = "..."
        keybindBtn.TextColor3 = THEME.Warning

        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= Enum.KeyCode.Escape then
                    currentKeybind = input.KeyCode
                    keybindBtn.Text = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
                    keybindBtn.TextColor3 = THEME.Primary
                    UI.SavedKeybinds[toggleKey] = input.KeyCode
                    SaveSettings()
                else
                    currentKeybind = nil
                    keybindBtn.Text = "---"
                    keybindBtn.TextColor3 = THEME.TextSecondary
                    UI.SavedKeybinds[toggleKey] = nil
                    SaveSettings()
                end
                isListeningForKey = false
                conn:Disconnect()
            end
        end)
    end)

    table.insert(parentObj.Elements, toggleFrame)

    local result = {
        Frame = toggleFrame,
        SetValue = function(val)
            toggleValue = val
            UpdateToggleState()
        end,
        GetValue = function() return toggleValue end
    }
    UI.Registry[text] = result
    return result
end

-- Reactive Color-Shifting Slider (shifts color towards red/custom at 100%)
function UILibrary:CreateSlider(parentObj, text, min, max, default, callback, options)
    options = options or {}
    local endColor = options.EndColor or THEME.Danger
    local sliderValue = default or min

    local sliderFrame = Instance.new("Frame")
    sliderFrame.Name = text
    sliderFrame.Size = UDim2.new(1, 0, 0, 58)
    sliderFrame.BackgroundColor3 = THEME.Surface
    sliderFrame.BorderSizePixel = 0
    sliderFrame.ZIndex = 5
    sliderFrame.Parent = parentObj.Frame

    CreateCorner(sliderFrame, 8)
    CreateStroke(sliderFrame, THEME.Border, 1, 0.5)
    ApplyTiltEffect(sliderFrame, 2.5)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -80, 0, 22)
    label.Position = UDim2.new(0, 14, 0, 8)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = THEME.Text
    label.TextSize = 13
    label.Font = Enum.Font.GothamMedium
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 6
    label.Parent = sliderFrame

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0, 60, 0, 22)
    valLabel.Position = UDim2.new(1, -74, 0, 8)
    valLabel.BackgroundTransparency = 1
    valLabel.Text = tostring(sliderValue)
    valLabel.TextColor3 = THEME.Primary
    valLabel.TextSize = 13
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.ZIndex = 6
    valLabel.Parent = sliderFrame

    local track = Instance.new("Frame")
    track.Name = "Track"
    track.Size = UDim2.new(1, -28, 0, 6)
    track.Position = UDim2.new(0, 14, 1, -18)
    track.BackgroundColor3 = THEME.Background
    track.BorderSizePixel = 0
    track.ZIndex = 6
    track.Parent = sliderFrame
    CreateCorner(track, 3)

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = THEME.Primary
    fill.BorderSizePixel = 0
    fill.ZIndex = 7
    fill.Parent = track
    CreateCorner(fill, 3)

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = THEME.Primary
    knob.BorderSizePixel = 0
    knob.ZIndex = 8
    knob.Parent = track

    CreateCorner(knob, 8)
    CreateStroke(knob, THEME.Text, 1.5, 0.1)

    local dragging = false

    local function UpdateSlider(input)
        local relX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        sliderValue = math.floor(min + (max - min) * relX)

        -- Reactive Color Interpolation
        local currentColor = LerpColor(THEME.Primary, endColor, relX)

        fill.Size = UDim2.new(relX, 0, 1, 0)
        fill.BackgroundColor3 = currentColor
        knob.Position = UDim2.new(relX, 0, 0.5, 0)
        knob.BackgroundColor3 = currentColor
        valLabel.Text = tostring(sliderValue)
        valLabel.TextColor3 = currentColor

        if callback then callback(sliderValue) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateSlider(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateSlider(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Initial position
    local initRatio = (sliderValue - min) / math.max(1, (max - min))
    fill.Size = UDim2.new(initRatio, 0, 1, 0)
    knob.Position = UDim2.new(initRatio, 0, 0.5, 0)

    table.insert(parentObj.Elements, sliderFrame)

    local result = {
        Frame = sliderFrame,
        SetValue = function(val)
            sliderValue = math.clamp(val, min, max)
            local r = (sliderValue - min) / math.max(1, (max - min))
            local c = LerpColor(THEME.Primary, endColor, r)
            fill.Size = UDim2.new(r, 0, 1, 0)
            fill.BackgroundColor3 = c
            knob.Position = UDim2.new(r, 0, 0.5, 0)
            knob.BackgroundColor3 = c
            valLabel.Text = tostring(sliderValue)
            valLabel.TextColor3 = c
        end,
        GetValue = function() return sliderValue end
    }
    UI.Registry[text] = result
    return result
end

