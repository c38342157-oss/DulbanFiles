            isHolding = true
            holdStart = tick()

            tweenFill = TweenService:Create(fillBar, TweenInfo.new(holdDuration, Enum.EasingStyle.Linear), {
                Size = UDim2.new(1, 0, 1, 0)
            })
            tweenFill:Play()

            task.spawn(function()
                while isHolding and (tick() - holdStart) < holdDuration do
                    task.wait(0.05)
                end

                if isHolding and (tick() - holdStart) >= holdDuration then
                    isHolding = false
                    CreateRippleEffect(dangerBtn, dangerBtn.AbsolutePosition.X + dangerBtn.AbsoluteSize.X/2, dangerBtn.AbsolutePosition.Y + 22, THEME.Danger)
                    if callback then callback() end
                    UILibrary.CreateNotification("Confirmed", text .. " activated!", 2)

                    task.wait(0.2)
                    TweenObject(fillBar, {Size = UDim2.new(0, 0, 1, 0)}, 0.3)
                end
            end)
        end
    end)

    dangerBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if isHolding then
                isHolding = false
                if tweenFill then tweenFill:Cancel() end
                TweenObject(fillBar, {Size = UDim2.new(0, 0, 1, 0)}, 0.2)
            end
        end
    end)

    table.insert(parentObj.Elements, dangerBtn)
    return dangerBtn
end

