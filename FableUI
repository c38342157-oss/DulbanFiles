-- ============================================================
-- ANIMATED BACKGROUND (звёзды/частицы за окном)
-- ============================================================
local function CreateAnimatedBackground(screenGui)
    local bg = new("Frame", {
        Name = "AnimatedBG",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(4, 4, 10),
        BorderSizePixel = 0,
        ZIndex = 0,
        Parent = screenGui,
    })

    -- Мягкие светящиеся пятна
    local blobs = {
        { color = Color3.fromRGB(88, 101, 242), pos = UDim2.new(0.15, 0, 0.2, 0), size = 420, speed = 0.35 },
        { color = Color3.fromRGB(139, 92, 246), pos = UDim2.new(0.75, 0, 0.65, 0), size = 520, speed = 0.28 },
        { color = Color3.fromRGB(59, 130, 246), pos = UDim2.new(0.5, 0, 0.05, 0), size = 360, speed = 0.42 },
    }
    local blobFrames = {}
    for i, b in ipairs(blobs) do
        local blob = new("Frame", {
            Size = UDim2.fromOffset(b.size, b.size),
            Position = b.pos,
            BackgroundColor3 = b.color,
            BackgroundTransparency = 0.88,
            BorderSizePixel = 0,
            ZIndex = 0,
            Parent = bg,
        })
        CreateCorner(blob, 999)
        table.insert(blobFrames, { frame = blob, base = b.pos, speed = b.speed })
    end

    -- Звёзды
    local stars = {}
    for i = 1, 40 do
        local star = new("Frame", {
            Size = UDim2.fromOffset(math.random(1, 3), math.random(1, 3)),
            Position = UDim2.fromScale(math.random(), math.random()),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = math.random(40, 80) / 100,
            BorderSizePixel = 0,
            ZIndex = 0,
            Parent = bg,
        })
        CreateCorner(star, 999)
        table.insert(stars, star)
        task.spawn(function()
            while star.Parent do
                Tween(star, math.random(15, 35) / 10, { BackgroundTransparency = 0.85 })
                task.wait(math.random(15, 35) / 10)
                if not star.Parent then break end
                Tween(star, math.random(15, 35) / 10, { BackgroundTransparency = math.random(30, 60) / 100 })
                task.wait(math.random(15, 35) / 10)
            end
        end)
    end

    -- Медленное дрейфование пятен
    task.spawn(function()
        local t = 0
        while bg.Parent do
            t += 0.016
            for _, b in ipairs(blobFrames) do
                local dx = math.sin(t * b.speed) * 30
                local dy = math.cos(t * b.speed * 0.8) * 24
                b.frame.Position = UDim2.new(b.base.X.Scale, b.base.X.Offset + dx, b.base.Y.Scale, b.base.Y.Offset + dy)
            end
            task.wait(0.05)
        end
    end)

    UI.AnimatedBG = bg
    return bg
end

-- ============================================================
-- TOGGLE UI: растворение + уменьшение / появление + пружина
-- ============================================================
function UILibrary:ToggleUI()
    local main = UI.MainFrame
    local backdrop = UI.Backdrop
    if not main then return end

    UI.IsOpen = not UI.IsOpen
    local scale = main:FindFirstChild("AnimationScale")

    if UI.IsOpen then
        -- Открытие: из маленького с растворением
        main.Visible = true
        if backdrop then
            backdrop.Visible = true
            backdrop.BackgroundTransparency = 1
            Tween(backdrop, 0.3, { BackgroundTransparency = 0.55 })
        end
        if scale then
            scale.Scale = 0.82
            main.GroupTransparency = 1
            Tween(main, 0.01, { GroupTransparency = 1 })
            Spring(scale, 0.45, { Scale = 1 })
            Tween(main, 0.25, { GroupTransparency = 0 })
        else
            Spring(main, 0.4, { Size = main.Size })
        end
    else
        -- Закрытие: испаряется + уменьшается
        if backdrop then
            Tween(backdrop, 0.25, { BackgroundTransparency = 1 })
        end
        if scale then
            Tween(scale, 0.22, { Scale = 0.85 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            local tw = Tween(main, 0.24, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tw.Completed:Connect(function()
                main.Visible = false
                main.GroupTransparency = 0
                if scale then scale.Scale = 1 end
                if backdrop then backdrop.Visible = false end
            end)
        else
            main.Visible = false
            if backdrop then backdrop.Visible = false end
        end
    end

    if UI.MobileToggleButton and UI.MobileToggleButton:FindFirstChild("Label") then
        UI.MobileToggleButton.Label.Text = UI.IsOpen and "✕" or "S"
    end
end

