function UILibrary:CreateSlider(parentObj, text, min, max, default, callback)
    local parent = parentObj.Frame or parentObj
    local value = default or min
    local draggingSlider = false

    local frame = new("Frame", {
        Name = text,
        Size = UDim2.new(1, 0, 0, 58),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        Parent = parent,
    })
    CreateCorner(frame, 10)
    CreateStroke(frame, THEME.Border, 1, 0.55)

    local label = new("TextLabel", {
        Size = UDim2.new(1, -90, 0, 20),
        Position = UDim2.fromOffset(14, 8),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local valueLabel = new("TextLabel", {
        Size = UDim2.fromOffset(70, 20),
        Position = UDim2.new(1, -82, 0, 8),
        BackgroundTransparency = 1,
        Text = tostring(value),
        TextColor3 = THEME.Primary,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })

    local track = new("TextButton", {
        Size = UDim2.new(1, -28, 0, 6),
        Position = UDim2.new(0, 14, 1, -20),
        BackgroundColor3 = THEME.SurfaceLight,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = frame,
    })
    CreateCorner(track, 999)

    local fillBar = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = THEME.Primary,
        BorderSizePixel = 0,
        Parent = track,
    })
    CreateCorner(fillBar, 999)
    CreateGradient(fillBar, THEME.Primary, THEME.Secondary, 0)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 0, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = track,
    })
    CreateCorner(knob, 999)
    CreateStroke(knob, THEME.Primary, 2, 0.1)

    AttachTilt(frame, 5)

    -- Связанная кнопка (если задана): краснеет по мере прокрутки
    local linkedUpdate = nil

    local function SetValue(v, fire)
        value = math.clamp(v, min, max)
        local p = (value - min) / (max - min)
        fillBar.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, -8 * p * 2 + (-8) * (1 - p), 0.5, -8)
        knob.Position = UDim2.new(p, -8, 0.5, -8)
        valueLabel.Text = (max - min > 10) and tostring(math.floor(value)) or tostring(math.floor(value * 10) / 10)
        -- Пружина на knob при перетаскивании
        if linkedUpdate then linkedUpdate(p) end
        if fire and callback then pcall(callback, value) end
    end

    local function FromInput(inputX)
        local abs = track.AbsolutePosition
        local w = track.AbsoluteSize.X
        local p = math.clamp((inputX - abs.X) / w, 0, 1)
        SetValue(min + (max - min) * p, true)
        Spring(knob, 0.2, { Size = UDim2.fromOffset(19, 19) })
    end

    track.MouseButton1Down:Connect(function()
        draggingSlider = true
        local m = UserInputService:GetMouseLocation()
        FromInput(m.X)
    end)
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            draggingSlider = true
            FromInput(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            FromInput(input.Position.X)
        end
        if draggingSlider and input.UserInputType == Enum.UserInputType.Touch then
            FromInput(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if draggingSlider then
                draggingSlider = false
                Spring(knob, 0.3, { Size = UDim2.fromOffset(16, 16) })
                if callback then pcall(callback, value) end
            end
        end
    end)

    SetValue(value, false)

    OnTheme(function()
        frame.BackgroundColor3 = THEME.Surface
        label.TextColor3 = THEME.Text
        valueLabel.TextColor3 = THEME.Primary
        track.BackgroundColor3 = THEME.SurfaceLight
        fillBar.BackgroundColor3 = THEME.Primary
    end)

    table.insert(parentObj.Elements or {}, frame)

    local result = {
        Frame = frame,
        GetValue = function() return value end,
        SetValue = function(v) SetValue(v, true) end,
        -- Подключить кнопку, которая краснеет от слайдера
        LinkButton = function(updateFn) linkedUpdate = updateFn linkedUpdate((value - min) / (max - min)) end,
    }
    return result
end

