function UILibrary:CreatePlayerList(parent)
    local holder = parent.Frame or parent

    local listFrame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 240),
        BackgroundColor3 = THEME.Surface,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = holder,
    })
    CreateCorner(listFrame, 12)
    CreateStroke(listFrame, THEME.Border, 1, 0.6)

    local scroll = new("ScrollingFrame", {
        Size = UDim2.new(1, -12, 1, -12),
        Position = UDim2.fromOffset(6, 6),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = THEME.Primary,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = listFrame,
    })
    local layout = new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })

    local function Refresh()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy() end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if not UI.FilterText or UI.FilterText == "" or plr.Name:lower():find(UI.FilterText:lower()) then
                self:CreatePlayerCard(scroll, plr, {})
            end
        end
    end
    Refresh()

    Players.PlayerAdded:Connect(function() task.wait(0.5) Refresh() end)
    Players.PlayerRemoving:Connect(function() task.wait(0.5) Refresh() end)

    OnTheme(function()
        listFrame.BackgroundColor3 = THEME.Surface
        scroll.ScrollBarImageColor3 = THEME.Primary
    end)

    table.insert(parent.Elements or {}, listFrame)
    return listFrame, Refresh
end

