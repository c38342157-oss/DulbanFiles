local function ConsoleLog(message, color)
    local frame = UI.ConsoleFrame
    if not frame then return end
    local line = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = "> " .. message,
        TextColor3 = color or THEME.Success,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    table.insert(UI.ConsoleLines, line)
    -- Максимум 60 строк
    while #UI.ConsoleLines > 60 do
        local old = table.remove(UI.ConsoleLines, 1)
        old:Destroy()
    end
    local scroll = frame.Parent
    if scroll and scroll:IsA("ScrollingFrame") then
        task.defer(function()
            scroll.CanvasPosition = Vector2.new(0, math.huge)
        end)
    end
end
