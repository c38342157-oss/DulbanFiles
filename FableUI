function UILibrary:AddChangelogText(text)
    table.insert(UI.ChangelogTexts, text)
    if not UI.ChangelogContainer then return end

    -- Пункт changelog как кнопка: hover — светлее и больше,
    -- click — текст на весь экран
    local parts = {}
    for part in tostring(text):gmatch("([^|]+)") do table.insert(parts, part) end
    local title = parts[1] or string.sub(tostring(text), 1, 40)
    local body = parts[2] or tostring(text)

    CreateChangelogButton(UI.ChangelogContainer, "• " .. title, body)
end

