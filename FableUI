function UILibrary:CreateToggle(parentObj, text, default, callback)
    local parent = parentObj.Frame or parentObj
    local toggleValue = default or false
    local currentKeybind = nil
    local isListeningForKey = false
    local toggleKey = UI.GAME_TYPE .. "_" .. text

    UI.RegisteredToggles[toggleKey] = {
        name = text, value = toggleValue, keybind = nil, callback = callback
    }

    local frame = new("Frame", {
        Name = text,
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = parent,
    })
    CreateCorner(frame, 10)
    local frameStroke = CreateStroke(frame, THEME.Border, 1, 0.55)

    -- Кнопка кейбинда
    local keyBtn = new("TextButton", {
        Size = UDim2.fromOffset(44, 24),
        Position = UDim2.new(0, 10, 0.5, -12),
        BackgroundColor3 = THEME.Background,
        BorderSizePixel = 0,
        Text = "---",
        TextColor3 = THEME.TextSecondary,
        Font = Enum.Font.Code,
        TextSize = 11,
        AutoButtonColor = false,
        ZIndex = 3,
        Parent = frame,
    })
    CreateCorner(keyBtn, 6)
    CreateStroke(keyBtn, THEME.Border, 1, 0.6)
    MakeInteractive(keyBtn, { Tilt = false, PressScale = 0.9 })

    local label = new("TextLabel", {
        Size = UDim2.new(1, -130, 1, 0),
        Position = UDim2.fromOffset(64, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
        Parent = frame,
    })

    -- Переключатель
    local switch = new("TextButton", {
        Size = UDim2.fromOffset(46, 24),
        Position = UDim2.new(1, -58, 0.5, -12),
        BackgroundColor3 = THEME.SurfaceLight,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 3,
        Parent = frame,
    })
    CreateCorner(switch, 999)

    local knob = new("Frame", {
        Name = "ToggleIndicator",
        Size = UDim2.fromOffset(18, 18),
        Position = UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = THEME.TextSecondary,
        BorderSizePixel = 0,
        ZIndex = 4,
        Parent = switch,
    })
    CreateCorner(knob, 999)

    local function UpdateToggle(animate)
        if toggleValue then
            Tween(switch, animate and 0.28 or 0, { BackgroundColor3 = THEME.Primary })
            Spring(knob, animate and 0.4 or 0, { Position = UDim2.new(1, -21, 0.5, -9), BackgroundColor3 = Color3.fromRGB(255,255,255) })
            frameStroke.Color = LerpC3(THEME.Primary, THEME.Border, 0.4)
            frameStroke.Transparency = 0.2
        else
            Tween(switch, animate and 0.28 or 0, { BackgroundColor3 = THEME.SurfaceLight })
            Spring(knob, animate and 0.4 or 0, { Position = UDim2.new(0, 3, 0.5, -9), BackgroundColor3 = THEME.TextSecondary })
            frameStroke.Color = THEME.Border
            frameStroke.Transparency = 0.55
        end
        UI.RegisteredToggles[toggleKey].value = toggleValue
        if callback then pcall(callback, toggleValue) end
        if UI.KeybindsMenuFrame and UILibrary.UpdateKeybindsMenu then UILibrary:UpdateKeybindsMenu() end
    end

    local function GetKeyName(k) return tostring(k):gsub("Enum.KeyCode.", "") end

    local keybindConnection = nil
    local function SetKeybind(keyCode)
        currentKeybind = keyCode
        keyBtn.Text = GetKeyName(keyCode)
        keyBtn.TextColor3 = THEME.Primary
        UI.SavedKeybinds[toggleKey] = keyCode
        UI.RegisteredToggles[toggleKey].keybind = keyCode
        SaveSettings()
        if keybindConnection then keybindConnection:Disconnect() end
        keybindConnection = UserInputService.InputBegan:Connect(function(input, gpe)
            if not gpe and input.KeyCode == keyCode then
                toggleValue = not toggleValue
                UpdateToggle(true)
            end
        end)
    end

    local function RemoveKeybind()
        currentKeybind = nil
        keyBtn.Text = "---"
        keyBtn.TextColor3 = THEME.TextSecondary
        UI.SavedKeybinds[toggleKey] = nil
        UI.RegisteredToggles[toggleKey].keybind = nil
        SaveSettings()
        if keybindConnection then keybindConnection:Disconnect() keybindConnection = nil end
    end

    keyBtn.MouseButton1Click:Connect(function()
        if isListeningForKey then return end
        isListeningForKey = true
        keyBtn.Text = "..."
        keyBtn.TextColor3 = THEME.Warning
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then
                    isListeningForKey = false
                    keyBtn.Text = currentKeybind and GetKeyName(currentKeybind) or "---"
                    keyBtn.TextColor3 = currentKeybind and THEME.Primary or THEME.TextSecondary
                    conn:Disconnect()
                elseif input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= UI.MenuKeybind then
                    SetKeybind(input.KeyCode)
                    isListeningForKey = false
                    conn:Disconnect()
                end
            end
        end)
    end)
    keyBtn.MouseButton2Click:Connect(function()
        if not isListeningForKey then RemoveKeybind() end
    end)

    switch.MouseButton1Click:Connect(function()
        toggleValue = not toggleValue
        local m = UserInputService:GetMouseLocation()
        Ripple(switch, m.X, m.Y, THEME.Primary)
        UpdateToggle(true)
    end)

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            Tween(frame, 0.18, { BackgroundColor3 = THEME.SurfaceLight })
        end
    end)
    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            Tween(frame, 0.25, { BackgroundColor3 = THEME.Surface })
        end
    end)

    AttachTilt(frame, 6)

    UpdateToggle(false)
    if UI.SavedKeybinds[toggleKey] then SetKeybind(UI.SavedKeybinds[toggleKey]) end

    OnTheme(function()
        frame.BackgroundColor3 = THEME.Surface
        label.TextColor3 = THEME.Text
        keyBtn.BackgroundColor3 = THEME.Background
        UpdateToggle(false)
    end)

    table.insert(parentObj.Elements or {}, frame)

    local result = {
        Frame = frame,
        SetValue = function(v) toggleValue = v UpdateToggle(true) end,
        GetValue = function() return toggleValue end,
        SetKeybind = SetKeybind,
        RemoveKeybind = RemoveKeybind,
        GetKeybind = function() return currentKeybind end,
    }
    UI.Registry[text] = result
    return result
end

