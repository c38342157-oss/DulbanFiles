function UILibrary:SaveConfig(configName)
    if not configName or configName == "" then
        self.CreateNotification("Configs", "Введите имя конфига", 3)
        return
    end
    local data = { Toggles = {}, Sliders = {} }
    for name, toggle in pairs(UI.RegisteredToggles) do
        data.Toggles[name] = toggle.value
    end
    local file = CONFIGS_FOLDER .. "/" .. configName .. ".json"
    pcall(function()
        writefile(file, HttpService:JSONEncode(data))
    end)
    self.CreateNotification("Configs", "Сохранено: " .. configName, 3)
    ConsoleLog("Config saved: " .. configName, THEME.Success)
end

function UILibrary:LoadConfig(configName)
    local file = CONFIGS_FOLDER .. "/" .. configName .. ".json"
    if not isfile(file) then
        self.CreateNotification("Configs", "Конфиг не найден", 3)
        return
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
    if not ok or not data then
        self.CreateNotification("Configs", "Ошибка чтения конфига", 3)
        return
    end
    if data.Toggles then
        for key, value in pairs(data.Toggles) do
            local t = UI.RegisteredToggles[key]
            if t and UI.Registry[t.name] then
                UI.Registry[t.name]:SetValue(value)
            end
        end
    end
    self.CreateNotification("Configs", "Загружено: " .. configName, 3)
    ConsoleLog("Config loaded: " .. configName, THEME.Success)
end

function UILibrary:RefreshConfigList()
    local scroll = UI.ConfigScroll
    if not scroll or not scroll.Parent then return end
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local files = {}
    pcall(function() files = listfiles(CONFIGS_FOLDER) end)

    if #files == 0 then
        local empty = new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundTransparency = 1,
            Text = "Конфигов пока нет — сохрани свой первый!",
            TextColor3 = THEME.TextSecondary,
            Font = Enum.Font.GothamItalic,
            TextSize = 12,
            Parent = scroll,
        })
        return
    end

    for i, file in ipairs(files) do
        local fileName = tostring(file):match("([^/\\]+)%.json$") or tostring(file)
        local card = new("Frame", {
            LayoutOrder = i,
            Size = UDim2.new(1, 0, 0, 72),
            BackgroundColor3 = THEME.Surface,
            BorderSizePixel = 0,
            Parent = scroll,
        })
        CreateCorner(card, 10)
        CreateStroke(card, THEME.Border, 1, 0.6)
        AttachHover(card, THEME.SurfaceLight)
        AttachTilt(card, 5)

        local nameLabel = new("TextLabel", {
            Size = UDim2.new(1, -170, 0, 20),
            Position = UDim2.fromOffset(12, 8),
            BackgroundTransparency = 1,
            Text = "📄 " .. fileName,
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = card,
        })

        local loadBtn = new("TextButton", {
            Size = UDim2.fromOffset(70, 26),
            Position = UDim2.new(1, -82, 0, 6),
            BackgroundColor3 = THEME.Success,
            BackgroundTransparency = 0.65,
            BorderSizePixel = 0,
            Text = "Load",
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            AutoButtonColor = false,
            Parent = card,
        })
        CreateCorner(loadBtn, 7)
        MakeInteractive(loadBtn, { Tilt = false, PressScale = 0.9 })

        local delBtn = new("TextButton", {
            Size = UDim2.fromOffset(70, 26),
            Position = UDim2.new(1, -82, 0, 38),
            BackgroundColor3 = THEME.Danger,
            BackgroundTransparency = 0.65,
            BorderSizePixel = 0,
            Text = "Delete",
            TextColor3 = THEME.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 12,
            AutoButtonColor = false,
            Parent = card,
        })
        CreateCorner(delBtn, 7)
        MakeInteractive(delBtn, { Tilt = false, PressScale = 0.9 })

        loadBtn.MouseButton1Click:Connect(function() self:LoadConfig(fileName) end)
        delBtn.MouseButton1Click:Connect(function()
            pcall(function() delfile(file) end)
            self.CreateNotification("Configs", "Удалено: " .. fileName, 3)
            self:RefreshConfigList()
        end)
    end
end

function UILibrary:CreateConfigTab()
    local configTab = self:CreateTab("Configs", "📁")
    if configTab.Button then configTab.Button.LayoutOrder = 9998 end

    self:CreateHeader(configTab, "Create Config")

    local configInput = self:CreateTextbox(configTab, "Config Name", "Введите имя конфига...", "")

    self:CreateButton(configTab, "Save / Overwrite Config", function()
        local name = configInput.GetValue()
        self:SaveConfig(name)
    end)

    self:CreateHeader(configTab, "Your Configs")

    local listContainer = new("Frame", {
        Size = UDim2.new(1, 0, 0, 300),
        BackgroundColor3 = THEME.Surface,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Parent = configTab.Frame,
    })
    CreateCorner(listContainer, 12)
    CreateStroke(listContainer, THEME.Primary, 1, 0.6)

    local scroll = new("ScrollingFrame", {
        Size = UDim2.new(1, -10, 1, -10),
        Position = UDim2.fromOffset(5, 5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = THEME.Primary,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Parent = listContainer,
    })
    local layout = new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)

    UI.ConfigScroll = scroll
    table.insert(configTab.Elements, listContainer)

    self:CreateButton(configTab, "Refresh List", function()
        self:RefreshConfigList()
    end)

    -- Danger-кнопка: удалить все конфиги (удержание 1 сек)
    self:CreateDangerButton(configTab, "Delete ALL configs (hold)", 1.5, function(active)
        if active then
            pcall(function()
                for _, f in ipairs(listfiles(CONFIGS_FOLDER)) do delfile(f) end
            end)
            self:RefreshConfigList()
            self.CreateNotification("Configs", "Все конфиги удалены", 3)
            ConsoleLog("Все конфиги удалены", THEME.Danger)
        end
    end)

    OnTheme(function()
        listContainer.BackgroundColor3 = THEME.Surface
        scroll.ScrollBarImageColor3 = THEME.Primary
    end)

    task.spawn(function() self:RefreshConfigList() end)
    return configTab
end

