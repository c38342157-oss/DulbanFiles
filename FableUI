-- RIPPLE: волна/капля от точки нажатия
local function Ripple(button, x, y, color)
    if not UI.Settings.RippleEnabled then return end
    local abs = button.AbsolutePosition
    local px = (x or abs.X + button.AbsoluteSize.X / 2) - abs.X
    local py = (y or abs.Y + button.AbsoluteSize.Y / 2) - abs.Y

    local ripple = new("Frame", {
        BackgroundColor3 = color or Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        Size = UDim2.fromOffset(0, 0),
        Position = UDim2.fromOffset(px, py),
        AnchorPoint = Vector2.new(0.5, 0.5),
        ZIndex = button.ZIndex + 5,
        Parent = button,
    })
    CreateCorner(ripple, 999)

    local maxDist = math.sqrt(button.AbsoluteSize.X ^ 2 + button.AbsoluteSize.Y ^ 2) * 2.2
    local tw = Tween(ripple, 0.65, {
        Size = UDim2.fromOffset(maxDist, maxDist),
        BackgroundTransparency = 1,
    }, Enum.EasingStyle.Quart)
    tw.Completed:Connect(function() ripple:Destroy() end)
end

-- TILT: элемент "прогибается" под весом курсора (3D-иллюзия)
local function AttachTilt(frame, power)
    power = power or UI.Settings.TiltPower
    local conn = nil
    local origPos = frame.Position
    local origSize = frame.Size

    frame.MouseEnter:Connect(function()
        if not UI.Settings.TiltEnabled then return end
        origPos = frame.Position
        origSize = frame.Size
        conn = RunService.RenderStepped:Connect(function()
            local m = UserInputService:GetMouseLocation()
            local abs = frame.AbsolutePosition
            local size = frame.AbsoluteSize
            if size.X <= 0 or size.Y <= 0 then return end
            local rx = (m.X - abs.X) / size.X - 0.5   -- -0.5..0.5
            local ry = (m.Y - abs.Y) / size.Y - 0.5
            -- Прогиб: контент смещается к курсору, размер чуть "вдавливается"
            local dx, dy = rx * power, ry * power
            local squeeze = 1 - (math.abs(rx) + math.abs(ry)) * 0.012
            frame.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + dx, origPos.Y.Scale, origPos.Y.Offset + dy)
            frame.Size = UDim2.new(origSize.X.Scale, origSize.X.Offset * squeeze, origSize.Y.Scale, origSize.Y.Offset * squeeze)
        end)
    end)

    frame.MouseLeave:Connect(function()
        if conn then conn:Disconnect() conn = nil end
        -- Пружинный возврат
        Spring(frame, 0.45, { Position = origPos, Size = origSize })
    end)
end

-- SPRING PRESS: пружина при нажатии (сжался -> отпружинил)
local function AttachPress(frame, scale)
    scale = scale or 0.94
    local origSize = frame.Size
    frame.MouseButton1Down:Connect(function()
        if not UI.Settings.AnimationsEnabled then return end
        Tween(frame, 0.08, {
            Size = UDim2.new(origSize.X.Scale, origSize.X.Offset * scale, origSize.Y.Scale, origSize.Y.Offset * scale)
        }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    end)
    local release = function()
        Spring(frame, 0.4, { Size = origSize })
    end
    frame.MouseButton1Up:Connect(release)
    frame.MouseLeave:Connect(function()
        if frame.Size ~= origSize then Spring(frame, 0.3, { Size = origSize }) end
    end)
end

-- HOVER: подсветка + лёгкое увеличение
local function AttachHover(frame, hoverColor, grow)
    local orig = frame.BackgroundColor3
    OnTheme(function()
        orig = frame.BackgroundColor3
    end)
    frame.MouseEnter:Connect(function()
        Tween(frame, 0.18, { BackgroundColor3 = hoverColor or THEME.Hover })
        if grow then
            Spring(frame, 0.35, {
                Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset + 4, frame.Size.Y.Scale, frame.Size.Y.Offset + 4)
            })
        end
    end)
    frame.MouseLeave:Connect(function()
        Tween(frame, 0.25, { BackgroundColor3 = orig })
    end)
end

-- Полный набор интерактивности для кнопок
local function MakeInteractive(button, opts)
    opts = opts or {}
    if opts.Hover ~= false then AttachHover(button, opts.HoverColor) end
    if opts.Tilt ~= false then AttachTilt(button, opts.TiltPower) end
    if opts.Press ~= false then AttachPress(button, opts.PressScale) end
    button.MouseButton1Down:Connect(function()
        local m = UserInputService:GetMouseLocation()
        Ripple(button, m.X, m.Y, opts.RippleColor)
    end)
end

-- ============================================================
-- DANGER BUTTON: удерживать, постепенно заполняется, потом
-- переключается во включённое положение
-- ============================================================
local function CreateDangerButton(parentObj, text, opts)
    opts = opts or {}
    local holdTime = opts.HoldTime or UI.Settings.DangerHoldTime
    local callback = opts.Callback or function() end

    local holder = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        Parent = parentObj,
    })

    local button = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent = holder,
    })
    CreateCorner(button, 10)
    local stroke = CreateStroke(button, THEME.Danger, 1.2, 0.5)

    local label = new("TextLabel", {
        Size = UDim2.new(1, -46, 1, 0),
        Position = UDim2.fromOffset(38, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
        Parent = button,
    })

    local icon = new("TextLabel", {
        Size = UDim2.fromOffset(22, 22),
        Position = UDim2.new(0, 10, 0.5, -11),
        BackgroundTransparency = 1,
        Text = "⚠️",
        TextSize = 14,
        ZIndex = 3,
        Parent = button,
    })

    local hint = new("TextLabel", {
        Size = UDim2.fromOffset(120, 16),
        Position = UDim2.new(1, -128, 0.5, -8),
        BackgroundTransparency = 1,
        Text = "удерживай",
        TextColor3 = THEME.TextSecondary,
        Font = Enum.Font.GothamItalic,
        TextSize = 10,
        ZIndex = 3,
        Parent = button,
    })

    -- Заполнение
    local fill = new("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = THEME.Danger,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = button,
    })
    CreateCorner(fill, 10)

    local enabled = false
    local holding = false
    local holdThread = nil

    local function SetVisual(on)
        enabled = on
        Tween(button, 0.3, { BackgroundColor3 = on and THEME.Danger or THEME.Surface })
        stroke.Color = on and THEME.Danger or THEME.Danger
        stroke.Transparency = on and 0.1 or 0.5
        label.TextColor3 = on and Color3.fromRGB(255, 255, 255) or THEME.Text
        hint.Text = on and "включено" or "удерживай"
        hint.TextColor3 = on and Color3.fromRGB(255, 230, 230) or THEME.TextSecondary
    end

    button.MouseButton1Down:Connect(function()
        holding = true
        local m = UserInputService:GetMouseLocation()
        Ripple(button, m.X, m.Y, Color3.fromRGB(255, 120, 130))
        holdThread = task.spawn(function()
            local start = os.clock()
            while holding do
                local p = math.clamp((os.clock() - start) / holdTime, 0, 1)
                fill.Size = UDim2.new(p, 0, 1, 0)
                if p >= 1 then
                    holding = false
                    SetVisual(not enabled)
                    Spring(button, 0.35, { Size = UDim2.new(1, 0, 1, 0) })
                    pcall(callback, enabled)
                    break
                end
                task.wait(0.016)
            end
        end)
    end)

    local function Stop()
        holding = false
        Tween(fill, 0.25, { Size = UDim2.new(0, 0, 1, 0) })
    end
    button.MouseButton1Up:Connect(Stop)
    button.MouseLeave:Connect(Stop)

    AttachHover(button)
    AttachPress(button)

    OnTheme(function()
        if not enabled then button.BackgroundColor3 = THEME.Surface end
        label.TextColor3 = enabled and Color3.fromRGB(255,255,255) or THEME.Text
        fill.BackgroundColor3 = THEME.Danger
    end)

    return {
        Instance = holder,
        GetValue = function() return enabled end,
        SetValue = function(v) SetVisual(v) pcall(callback, v) end,
    }
end

-- ============================================================
-- SLIDER-LINKED BUTTON: цвет кнопки зависит от значения
-- слайдера (до конца = краснеет сильнее всего)
-- ============================================================
local function CreateSliderLinkedButton(parentObj, text, opts)
    opts = opts or {}
    local callback = opts.Callback or function() end
    local linkColor = opts.LinkColor or UI.Settings.SliderLinkColor
    local baseColor = opts.BaseColor or THEME.Surface

    local button = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundColor3 = baseColor,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent = parentObj,
    })
    CreateCorner(button, 10)
    local stroke = CreateStroke(button, THEME.Border, 1, 0.5)

    MakeInteractive(button, {})

    local progress = 0
    local function UpdateFromSlider(value01)
        progress = math.clamp(value01 or 0, 0, 1)
        button.BackgroundColor3 = LerpC3(baseColor, linkColor, progress)
        stroke.Color = LerpC3(THEME.Border, linkColor, progress)
        stroke.Transparency = 0.5 - progress * 0.35
    end

    button.MouseButton1Click:Connect(function() pcall(callback) end)

    OnTheme(function()
        baseColor = opts.BaseColor or THEME.Surface
        UpdateFromSlider(progress)
        button.TextColor3 = THEME.Text
    end)

    return {
        Instance = button,
        Update = UpdateFromSlider,
        GetProgress = function() return progress end,
    }
end

