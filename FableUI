function UILibrary:CreateKeybind(parentObj, text, defaultKey, callback)
    local parent = parentObj.Frame or parentObj
    local current = defaultKey or Enum.KeyCode.Unknown
    local listening = false

    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        Parent = parent,
    })
    CreateCorner(frame, 10)
    CreateStroke(frame, THEME.Border, 1, 0.55)

    local label = new("TextLabel", {
        Size = UDim2.new(1, -110, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })

    local keyButton = new("TextButton", {
        Size = UDim2.fromOffset(84, 30),
        Position = UDim2.new(1, -96, 0.5, -15),
        BackgroundColor3 = THEME.Background,
        BorderSizePixel = 0,
        Text = current ~= Enum.KeyCode.Unknown and tostring(current):gsub("Enum.KeyCode.", "") or "---",
        TextColor3 = THEME.Primary,
        Font = Enum.Font.Code,
        TextSize = 12,
        AutoButtonColor = false,
        Parent = frame,
    })
    CreateCorner(keyButton, 8)
    CreateStroke(keyButton, THEME.Primary, 1, 0.6)
    MakeInteractive(keyButton, { Tilt = false, PressScale = 0.92 })

    keyButton.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        keyButton.Text = "..."
        keyButton.TextColor3 = THEME.Warning
        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode ~= Enum.KeyCode.Unknown then
                    current = input.KeyCode
                    keyButton.Text = tostring(current):gsub("Enum.KeyCode.", "")
                    keyButton.TextColor3 = THEME.Primary
                    if callback then pcall(callback, current) end
                end
                listening = false
                conn:Disconnect()
            end
        end)
    end)

    AttachTilt(frame, 4)

    OnTheme(function()
        frame.BackgroundColor3 = THEME.Surface
        label.TextColor3 = THEME.Text
        keyButton.BackgroundColor3 = THEME.Background
        keyButton.TextColor3 = THEME.Primary
    end)

    table.insert(parentObj.Elements or {}, frame)
    return {
        Frame = frame,
        GetValue = function() return current end,
        SetValue = function(k) current = k keyButton.Text = tostring(k):gsub("Enum.KeyCode.", "") end,
    }
end

