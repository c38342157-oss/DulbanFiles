-- СМЕНА ТЕМЫ (плавная: все элементы перекрашиваются Tween-ом)
-- ============================================================
function UILibrary:SetTheme(themeName, customColor, shouldSave)
    if themeName == "Custom" and customColor then
        UI.CurrentTheme = "Custom"
        THEME.Primary = customColor
        local h, s, v = customColor:ToHSV()
        THEME.Secondary = Color3.fromHSV(h, math.clamp(s, 0.2, 1), math.clamp(v - 0.15, 0, 1))
        THEME.Glow = customColor
        THEME.Accent = Color3.fromHSV(h, s, math.clamp(v + 0.1, 0, 1))
    elseif Themes[themeName] then
        UI.CurrentTheme = themeName
        for k, v in pairs(Themes[themeName]) do THEME[k] = v end
    else
        return
    end

    NotifyTheme()
    ConsoleLog("Тема изменена: " .. tostring(themeName), THEME.Secondary)

    if shouldSave ~= false then SaveSettings() end
end

