        AutoButtonColor = false,
        ZIndex = 21,
        Parent = frame,
    })
    CreateCorner(dropBtn, 8)

    local arrow = new("TextLabel", {
        Size = UDim2.fromOffset(20, 1),
        Position = UDim2.new(1, -26, 0, 0),
        BackgroundTransparency = 1,
        Text = "▼",
        TextColor3 = THEME.TextSecondary,
        TextSize = 9,
        ZIndex = 22,
        Parent = dropBtn,
    })

    local listHolder = new("Frame", {
        Size = UDim2.new(1, -20, 0, 0),
        Position = UDim2.new(0, 10, 1, 4),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        Visible = false,
        ClipsDescendants = true,
        ZIndex = 30,
        Parent = frame,
    })
    CreateCorner(listHolder, 8)
    CreateStroke(listHolder, THEME.Primary, 1, 0.5)

    local listLayout = new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = listHolder })

    local itemButtons = {}
    for i, opt in ipairs(options) do
        local item = new("TextButton", {
            LayoutOrder = i,
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = THEME.Surface,
            BorderSizePixel = 0,
            Text = "  " .. tostring(opt),
            TextColor3 = THEME.TextSecondary,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            ZIndex = 31,
            Parent = listHolder,
        })
        item.MouseEnter:Connect(function()
            Tween(item, 0.12, { BackgroundColor3 = THEME.Hover, TextColor3 = THEME.Text })
        end)
        item.MouseLeave:Connect(function()
            Tween(item, 0.15, { BackgroundColor3 = THEME.Surface, TextColor3 = THEME.TextSecondary })
        end)
        item.MouseButton1Click:Connect(function()
            selected = opt
            dropBtn.Text = "  " .. tostring(opt)
            ToggleList(false)
            if callback then pcall(callback, opt) end
        end)
        table.insert(itemButtons, item)
    end

    function ToggleList(state)
        open = state
        if state then
            listHolder.Visible = true
            Tween(listHolder, 0.25, { Size = UDim2.new(1, -20, 0, math.min(#options * 30 + 8, 150)) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 1.2)
            Tween(arrow, 0.25, { Rotation = 180 })
        else
            Tween(listHolder, 0.18, { Size = UDim2.new(1, -20, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            Tween(arrow, 0.2, { Rotation = 0 })
            task.delay(0.2, function() if not open then listHolder.Visible = false end end)
        end
    end

    dropBtn.MouseButton1Click:Connect(function()
        local m = UserInputService:GetMouseLocation()
        Ripple(dropBtn, m.X, m.Y)
        ToggleList(not open)
    end)

    AttachTilt(frame, 4)

    OnTheme(function()
        frame.BackgroundColor3 = THEME.Surface
        label.TextColor3 = THEME.TextSecondary
        dropBtn.BackgroundColor3 = THEME.Background
        dropBtn.TextColor3 = THEME.Text
        listHolder.BackgroundColor3 = THEME.Surface
    end)

    table.insert(parentObj.Elements or {}, frame)
    return {
        Frame = frame,
        GetValue = function() return selected end,
        SetValue = function(v) selected = v dropBtn.Text = "  " .. tostring(v) if callback then pcall(callback, v) end end,
    }
end

