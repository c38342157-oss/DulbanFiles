function UILibrary:CreateFpsCounter()
    if UI.FpsFrame then return UI.FpsFrame end
    local frame = new("Frame", {
        Name = "FpsCounter",
        Size = UDim2.fromOffset(86, 26),
        Position = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = THEME.Surface,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        ZIndex = 700,
        Parent = UI.ScreenGui,
    })
    CreateCorner(frame, 8)
    CreateStroke(frame, THEME.Primary, 1, 0.5)

    local label = new("TextLabel", {
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.fromOffset(8, 0),
        BackgroundTransparency = 1,
        Text = "FPS: --",
        TextColor3 = THEME.Text,
        Font = Enum.Font.Code,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 701,
        Parent = frame,
    })
    UI.FpsFrame = frame

    local frames, last = 0, os.clock()
    RunService.RenderStepped:Connect(function()
        if not frame.Parent then return end
        frames += 1
        local now = os.clock()
        if now - last >= 0.5 then
            local fpsVal = math.floor(frames / (now - last))
            label.Text = "FPS: " .. fpsVal
            label.TextColor3 = fpsVal >= 50 and THEME.Success or (fpsVal >= 30 and THEME.Warning or THEME.Danger)
            frames, last = 0, now
        end
    end)

    OnTheme(function() frame.BackgroundColor3 = THEME.Surface end)
    return frame
end

function UILibrary:ToggleFpsCounter(enabled)
    if enabled then
        local f = self:CreateFpsCounter()
        f.Visible = true
        f.BackgroundTransparency = 1
        Tween(f, 0.25, { BackgroundTransparency = 0.15 })
    elseif UI.FpsFrame then
        Tween(UI.FpsFrame, 0.2, { BackgroundTransparency = 1 })
        task.delay(0.22, function() if UI.FpsFrame then UI.FpsFrame.Visible = false end end)
    end
end

