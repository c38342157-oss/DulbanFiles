function UILibrary:UpdateKeybindsMenu()
    local list = UI.KeybindsList
    if not list or not list.Parent then return end
    for _, c in ipairs(list:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end

    local count = 0
    for key, data in pairs(UI.RegisteredToggles) do
        if data.keybind then
            count += 1
            local row = new("Frame", {
                Size = UDim2.new(1, 0, 0, 26),
                BackgroundColor3 = THEME.SurfaceLight,
                BackgroundTransparency = 0.4,
                BorderSizePixel = 0,
                ZIndex = 722,
                Parent = list,
            })
            CreateCorner(row, 6)

            new("TextLabel", {
                Size = UDim2.new(1, -60, 1, 0),
                Position = UDim2.fromOffset(8, 0),
                BackgroundTransparency = 1,
                Text = data.name,
                TextColor3 = THEME.Text,
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 723,
                Parent = row,
            })

            new("TextLabel", {
                Size = UDim2.fromOffset(48, 18),
                Position = UDim2.new(1, -54, 0.5, -9),
                BackgroundColor3 = THEME.Primary,
                BackgroundTransparency = 0.7,
                Text = tostring(data.keybind):gsub("Enum.KeyCode.", ""),
                TextColor3 = THEME.Text,
                Font = Enum.Font.Code,
                TextSize = 10,
                ZIndex = 723,
                Parent = row,
            })
        end
    end

    if count == 0 then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundTransparency = 1,
            Text = "Нет активных кейбиндов",
            TextColor3 = THEME.TextSecondary,
            Font = Enum.Font.GothamItalic,
            TextSize = 11,
            ZIndex = 723,
            Parent = list,
        })
    end

    UI.KeybindsMenuFrame.Size = UDim2.fromOffset(240, 44 + math.max(count, 1) * 30)
end

function UILibrary:ToggleKeybindsMenu()
    local frame = UI.KeybindsMenuFrame or self:CreateKeybindsMenu()
    self:UpdateKeybindsMenu()
    frame.Visible = not frame.Visible
    if frame.Visible then
        Spring(frame, 0.35, { Size = UDim2.fromOffset(240, frame.Size.Y.Offset) })
    end
end

function UILibrary:RegisterToggleForKeybinds(toggleName, toggleKey, keybind, isActive)
    UI.RegisteredToggles[toggleKey or toggleName] = {
        name = toggleName, value = isActive or false, keybind = keybind,
    }
    self:UpdateKeybindsMenu()
end

