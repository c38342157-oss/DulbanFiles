function UILibrary:CreateSnowflake()
    local gui = UI.ScreenGui
    if not gui then return end
    local flake = new("TextLabel", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.fromScale(math.random(), -0.05),
        BackgroundTransparency = 1,
        Text = "❄",
        TextColor3 = Color3.fromRGB(200, 220, 255),
        TextTransparency = 0.3,
        Font = Enum.Font.GothamBold,
        TextSize = math.random(8, 16),
        ZIndex = 690,
        Parent = gui,
    })
    local dur = math.random(60, 120) / 10
    local tw = Tween(flake, dur, {
        Position = UDim2.fromScale(math.random(), 1.05),
        Rotation = math.random(-360, 360),
    }, Enum.EasingStyle.Linear)
    tw.Completed:Connect(function() flake:Destroy() end)
end

function UILibrary:CreateSnowflakes()
    UI.SnowEnabled = true
    task.spawn(function()
        while UI.SnowEnabled and UI.ScreenGui and UI.ScreenGui.Parent do
            self:CreateSnowflake()
            task.wait(math.random(20, 60) / 100)
        end
    end)
end

function UILibrary:ToggleSnowflakes(enabled)
    UI.SnowEnabled = enabled
    if enabled then self:CreateSnowflakes() end
end

