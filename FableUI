-- ============================================================
-- DRAG: плавное перетаскивание с инерцией
-- ============================================================
local function MakeDraggable(frame, handle, guiInset)
    local dragging = false
    local dragStart, startPos
    local lastPos = startPos
    local velocity = Vector2.new(0, 0)
    local lastMoveTime = os.clock()

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            lastPos = startPos
            lastMoveTime = os.clock()
            -- Чуть приподнимаем при начале перетаскивания
            Tween(frame, 0.15, { BackgroundTransparency = frame.BackgroundTransparency })
        end
    end)

    handle.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            -- Инерция
            local now = os.clock()
            local dt = math.max(now - lastMoveTime, 0.001)
            velocity = Vector2.new(
                (newPos.X.Offset - lastPos.X.Offset) / dt,
                (newPos.Y.Offset - lastPos.Y.Offset) / dt
            )
            lastPos = newPos
            lastMoveTime = now
            -- Короткий догоняющий твин — движение плавное, не резкое
            Tween(frame, 0.08, { Position = newPos }, Enum.EasingStyle.Quad)
        end
    end)

    local function End()
        if dragging then
            dragging = false
            -- Мягкое затухание инерции
            local target = UDim2.new(
                frame.Position.X.Scale, frame.Position.X.Offset + velocity.X * 0.06,
                frame.Position.Y.Scale, frame.Position.Y.Offset + velocity.Y * 0.06
            )
            Tween(frame, 0.35, { Position = target }, Enum.EasingStyle.Quint)
        end
    end
    handle.InputEnded:Connect(End)
    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            -- не прерываем drag при движении
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            End()
        end
    end)
end

