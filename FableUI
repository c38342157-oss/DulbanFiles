function UILibrary:CreateTab(name, icon)
    if UI.Tabs[name] then return UI.Tabs[name] end

    local sidebar = UI.Sidebar
    local navScroll = sidebar and sidebar:FindFirstChild("NavScroll")
    local order = (#UI.Tabs + 1) * 10

    local navButton = nil
    if navScroll then
        navButton = CreateNavButton(navScroll, name, icon, order)
    end

    local frame = new("ScrollingFrame", {
        Name = "TabContent_" .. name,
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 5,
        ScrollBarImageColor3 = THEME.Primary,
        ScrollBarImageTransparency = 0.4,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 6,
        Parent = UI.ContentFrame,
    })

    local layout = new("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = frame,
    })
    CreatePadding(frame, 16, 16, 22, 22)

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        frame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 32)
    end)

    local tab = {
        Name = name,
        Icon = icon or NAV_ICONS[name] or "•",
        Button = navButton,
        Frame = frame,
        Elements = {},
    }
    UI.Tabs[name] = tab
    if navButton then
        UI.TabButtons[name] = navButton
        navButton.MouseButton1Click:Connect(function()
            self:OpenTab(tab)
        end)
    end

    OnTheme(function()
        frame.ScrollBarImageColor3 = THEME.Primary
    end)

    return tab
end

-- Плавный переход между вкладками
function UILibrary:OpenTab(tab)
    if type(tab) == "string" then tab = UI.Tabs[tab] end
    if not tab or UI.CurrentTab == tab then return end

    local oldTab = UI.CurrentTab

    -- Погасить старую кнопку
    if oldTab and oldTab.Button then
        local ind = oldTab.Button:FindFirstChildOfClass("Frame")
        Tween(oldTab.Button, 0.2, { BackgroundTransparency = 1 })
        for _, c in ipairs(oldTab.Button:GetChildren()) do
            if c:IsA("TextLabel") and c.Text ~= "" and not string.find(c.Text, "[🏠📜⚙🎮⚡☁🔧•]") then
                Tween(c, 0.2, { TextColor3 = THEME.TextSecondary })
            end
        end
        if ind then Tween(ind, 0.25, { Size = UDim2.fromOffset(3, 0) }) end
    end

    -- Зажечь новую кнопку
    if tab.Button then
        Tween(tab.Button, 0.2, { BackgroundColor3 = THEME.Primary, BackgroundTransparency = 0.78 })
        for _, c in ipairs(tab.Button:GetChildren()) do
            if c:IsA("TextLabel") and c.Font == Enum.Font.GothamMedium then
                Tween(c, 0.2, { TextColor3 = THEME.Text })
            end
        end
        local ind
        for _, c in ipairs(tab.Button:GetChildren()) do
            if c:IsA("Frame") then ind = c break end
        end
        if ind then Spring(ind, 0.4, { Size = UDim2.fromOffset(3, 22) }) end
    end

    -- Обновить хедер
    if UI.HeaderTitle then
        UI.HeaderTitle.Text = tab.Name
    end

    -- Анимация перехода контента: растворение старой + выезд новой
    local newFrame = tab.Frame
    if oldTab and oldTab.Frame then
        local oldFrame = oldTab.Frame
        oldFrame.CanvasPosition = Vector2.new(0, 0)
        Tween(oldFrame, 0.16, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.17, function()
            oldFrame.Visible = false
            pcall(function() oldFrame.GroupTransparency = 0 end)
        end)
        task.delay(0.17, function()
            newFrame.GroupTransparency = 1
            newFrame.Visible = true
            newFrame.Position = UDim2.new(0, 24, 0, 0)
            Tween(newFrame, 0.3, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
        end)
    else
        newFrame.GroupTransparency = 1
        newFrame.Position = UDim2.new(0, 24, 0, 0)
        newFrame.Visible = true
        Tween(newFrame, 0.35, { GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Quint)
    end

    UI.CurrentTab = tab
end

