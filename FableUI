-- CHANGELOG: пункт как кнопка; hover — светлее и больше;
-- click — текст на весь экран
-- ============================================================
local function CreateChangelogButton(parentObj, title, text)
    local button = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = THEME.Surface,
        BorderSizePixel = 0,
        Text = "  " .. title,
        TextColor3 = THEME.Text,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ClipsDescendants = true,
        Parent = parentObj,
    })
    CreateCorner(button, 10)
    CreateStroke(button, THEME.Border, 1, 0.6)

    local baseSize = button.Size

    -- Hover: чуть светлее и больше остальных
    button.MouseEnter:Connect(function()
        Tween(button, 0.2, { BackgroundColor3 = THEME.SurfaceLight })
        Spring(button, 0.35, { Size = UDim2.new(1, 6, 0, 44) })
    end)
    button.MouseLeave:Connect(function()
        Tween(button, 0.25, { BackgroundColor3 = THEME.Surface })
        Spring(button, 0.3, { Size = baseSize })
    end)

    button.MouseButton1Down:Connect(function()
        local m = UserInputService:GetMouseLocation()
        Ripple(button, m.X, m.Y)
    end)

    -- Fullscreen просмотр
    button.MouseButton1Click:Connect(function()
        UILibrary:ShowChangelogFullscreen(title, text)
    end)

    OnTheme(function()
        button.BackgroundColor3 = THEME.Surface
        button.TextColor3 = THEME.Text
    end)

    return button
end

