local function SaveSettings()
    local settings = {
        MenuKeybind = tostring(UI.MenuKeybind),
        Keybinds = {},
        MobileButtonSize = UI.MobileButtonSize,
        Theme = UI.CurrentTheme,
        Settings = {
            DangerHoldTime = UI.Settings.DangerHoldTime,
            RippleEnabled = UI.Settings.RippleEnabled,
            TiltEnabled = UI.Settings.TiltEnabled,
            AnimationsEnabled = UI.Settings.AnimationsEnabled,
        },
    }
    for toggleName, keyCode in pairs(UI.SavedKeybinds) do
        settings.Keybinds[toggleName] = tostring(keyCode)
    end
    pcall(function()
        writefile(SETTINGS_FILE, HttpService:JSONEncode(settings))
    end)
end

local function LoadSettings()
    if isfile(SETTINGS_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(SETTINGS_FILE))
        end)
        if success and result then
            if result.MenuKeybind then
                local keyCode = result.MenuKeybind:gsub("Enum.KeyCode.", "")
                UI.MenuKeybind = Enum.KeyCode[keyCode] or Enum.KeyCode.Home
            end
            if result.Keybinds then
                for toggleName, keyCodeStr in pairs(result.Keybinds) do
                    local keyCode = keyCodeStr:gsub("Enum.KeyCode.", "")
                    UI.SavedKeybinds[toggleName] = Enum.KeyCode[keyCode]
                end
            end
            if result.MobileButtonSize then
                UI.MobileButtonSize = result.MobileButtonSize
            end
            if result.Theme and Themes[result.Theme] then
                UI.CurrentTheme = result.Theme
                for k, v in pairs(Themes[result.Theme]) do THEME[k] = v end
            end
            if result.Settings then
                local s = result.Settings
                if s.DangerHoldTime then UI.Settings.DangerHoldTime = s.DangerHoldTime end
                if s.RippleEnabled ~= nil then UI.Settings.RippleEnabled = s.RippleEnabled end
                if s.TiltEnabled ~= nil then UI.Settings.TiltEnabled = s.TiltEnabled end
                if s.AnimationsEnabled ~= nil then UI.Settings.AnimationsEnabled = s.AnimationsEnabled end
            end
            return true
        end
    end
    return false
end

